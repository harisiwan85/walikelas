# ============================================================
# Mode Supabase (produksi)
# Isi dari dashboard Supabase → Project Settings → API.
# Bila kedua variabel ini diisi, aplikasi memakai Supabase
# (Postgres + Supabase Auth). Service role key TIDAK boleh
# bocor ke browser — hanya dipakai sisi server.
# ============================================================
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ============================================================
# Mode lokal / development (default)
# Tanpa variabel di atas, aplikasi berjalan dengan SQLite
# lokal (file data/wali-kelas.db) + autentikasi scrypt,
# sehingga bisa langsung diuji tanpa akun Supabase.
# ============================================================
